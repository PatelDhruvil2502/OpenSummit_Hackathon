# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files can contain account IDs and secrets. Keep the two
# sanitized templates tracked so every deploy target has an explicit contract.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# vercel
.vercel

/dist/
/.wrangler/
/output/
/outputs/
/work/
/tmp/
*.tsbuildinfo
