# Local Worker runtime values. Copy to .dev.vars; that file is gitignored.
# Production values belong in OpenAI Sites or Cloudflare Worker settings.

# Password-reset delivery (the only external API used by WageShield).
RESEND_API_KEY=re_replace_with_a_resend_key
EMAIL_FROM="WageShield <no-reply@your-domain.example>"
EMAIL_REPLY_TO=support@your-domain.example

# Canonical HTTPS origin used to build password-reset links in production.
# Localhost falls back to the request origin when this is left unset.
PUBLIC_APP_URL=https://app.your-domain.example

# true only behind OpenAI Sites or another gateway proven to strip client
# copies of oai-authenticated-user-* and inject authenticated values itself.
# Keep false for a directly reachable Cloudflare Worker.
TRUST_FORWARDED_IDENTITY=false

# Leave false for the real-data investor deployment. Set true only when you
# intentionally want the explicitly fictional fixture sandbox.
ENABLE_SANDBOX=false

# The served policy pages read these at runtime in the Worker as well.
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Replace with registered operating entity"
NEXT_PUBLIC_COMPANY_JURISDICTION="Replace with governing jurisdiction and venue"
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example
NEXT_PUBLIC_SECURITY_EMAIL=security@your-domain.example
