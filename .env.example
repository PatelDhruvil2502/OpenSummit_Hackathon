# Copy to .env.local for local development. Never commit real secrets.

# PostgreSQL. Render supplies its internal connection string automatically from
# the database declared in render.yaml.
DATABASE_URL=postgresql://wageshield:replace-me@127.0.0.1:5432/wageshield
DATABASE_POOL_MAX=5

# Uploaded documents and generated reports are stored privately in PostgreSQL.
OBJECT_STORAGE_DRIVER=postgres
# Capacity guards for the 5 GB Render disk: 3 GiB total private objects and
# 1.5 GiB per account. These are operational limits, not secrets or API keys.
OBJECT_STORAGE_GLOBAL_MAX_BYTES=3221225472
OBJECT_STORAGE_ACCOUNT_MAX_BYTES=1610612736

# Password-reset delivery through Resend. These may stay blank only during
# localhost development; Render prompts for real production values.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Two-pass AI Evidence Copilot. All values are server-side; never rename
# the API key with a NEXT_PUBLIC_ prefix. Without both a key and exact model ID,
# uploads continue through local parsing/manual review and report AI as
# unavailable. OpenRouter exposes an OpenAI-compatible endpoint at this URL.
OPENROUTER_API_KEY=
AI_EVIDENCE_BASE_URL=https://openrouter.ai/api/v1
AI_EVIDENCE_MODEL=qwen/qwen3-vl-8b-instruct
# Optional separate verifier model. Blank means use AI_EVIDENCE_MODEL.
AI_EVIDENCE_VERIFIER_MODEL=
# Bounded per-request timeout in milliseconds; code clamps this to 5-60 seconds.
AI_EVIDENCE_TIMEOUT_MS=45000
# Keep false for private records. Set true only for a synthetic-only demo when
# deliberately using a free endpoint whose provider may collect prompt data.
AI_EVIDENCE_ALLOW_PROVIDER_DATA_COLLECTION=false

# Exact public HTTPS origin, with no trailing path, query, or fragment. Render's
# generated onrender.com URL is detected automatically when this is unset; set
# this explicitly when you attach a custom domain. Leaving it blank also lets
# local development use the localhost request origin.
PUBLIC_APP_URL=

# Keep both false on a directly reachable real-record Render deployment.
TRUST_FORWARDED_IDENTITY=false
ENABLE_SANDBOX=false
ALLOW_PUBLIC_SIGNUP=false

# Required private-beta gate. Separate approved addresses with commas. With
# ALLOW_PUBLIC_SIGNUP=false, a missing, blank, or invalid list fails closed and
# nobody can register.
INVESTOR_EMAIL_ALLOWLIST=you@example.com,investor@example.com

# Required launch identity. These values render on the served policy pages.
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Replace with registered operating entity"
NEXT_PUBLIC_COMPANY_JURISDICTION="Replace with governing jurisdiction and venue"
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example
NEXT_PUBLIC_SECURITY_EMAIL=security@your-domain.example
