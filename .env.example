# Build and direct-Cloudflare resource configuration.
# Copy to .env.local for development. Never put real secrets in this file.

# Required only for a direct Cloudflare deployment. OpenAI Sites owns these
# resources and needs only the logical DB/BUCKET names in .openai/hosting.json.
CLOUDFLARE_WORKER_NAME=wageshield-h1b
CLOUDFLARE_D1_DATABASE_NAME=wageshield-production
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=wageshield-private-documents
CLOUDFLARE_RETENTION_CRON="*/15 * * * *"

# Required launch identity. These values render on the served policy pages.
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Replace with registered operating entity"
NEXT_PUBLIC_COMPANY_JURISDICTION="Replace with governing jurisdiction and venue"
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example
NEXT_PUBLIC_SECURITY_EMAIL=security@your-domain.example
